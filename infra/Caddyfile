# TLS automático (Let's Encrypt). Los dominios vienen del entorno del contenedor.

{$API_DOMAIN} {
	encode zstd gzip

	# Socket.io y REST van al mismo proceso.
	reverse_proxy api:3000 {
		header_up X-Real-IP {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Cuerpo máximo: audio + foto (sección 6: 10 MB por archivo).
	request_body {
		max_size 25MB
	}

	log {
		output file /data/access-api.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}

# Audio y fotos: MinIO hacia afuera, solo lectura. Las URLs vienen firmadas por la API (5 min) contra
# este host; Caddy reenvía el Host original, así que MinIO valida la firma. El bucket es privado: sin
# firma no se lee nada. Escribir y listar solo es posible desde la red interna.
{$MEDIA_DOMAIN} {
	@noread not method GET HEAD
	respond @noread 405

	reverse_proxy minio:9000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Cache-Control "private, no-store"
		-Server
	}
}

# La central Next.js.
{$CENTRAL_DOMAIN} {
	encode zstd gzip
	reverse_proxy command:3001
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# La sesión vive en localStorage: connect/img/media solo hacia la API impiden sacar el token
		# a otro dominio. 'unsafe-inline' en script-src lo exige el arranque de Next (nonce: pendiente).
		# Fotos y audio se cargan desde MEDIA_DOMAIN (URLs firmadas): solo img-src y media-src, nunca connect-src.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://tile.openstreetmap.org https://{$API_DOMAIN} https://{$MEDIA_DOMAIN}; media-src 'self' blob: https://{$API_DOMAIN} https://{$MEDIA_DOMAIN}; connect-src 'self' https://{$API_DOMAIN} wss://{$API_DOMAIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
