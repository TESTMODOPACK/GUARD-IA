# ---------------------------------------------------------------------------
# Guard-IA · producción en un VPS con Docker Compose.
#   cp .env.production.example .env      (en infra/; nunca subir .env al repo)
#   docker compose up -d --build
# Lo leen dos cosas: docker compose (para armar contenedores) y la API (env_file).
# Generar cada secreto con:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-40
# La API no arranca si algo queda inválido para producción (validateEnv).
# ---------------------------------------------------------------------------

# --- Dominios (DNS tipo A apuntando al VPS antes de levantar Caddy: el TLS es automático) ---
API_DOMAIN=api.example.cl
CENTRAL_DOMAIN=central.example.cl
# Consola de plataforma (equipo Guard-IA): dominio propio, separado de la central.
PLATFORM_DOMAIN=plataforma.example.cl
# Audio y fotos que abre la central (MinIO detrás de Caddy, solo lectura con URL firmada).
MEDIA_DOMAIN=media.example.cl
# URL pública de la API: la usan la central (se fija al construir su imagen) y los links.
PUBLIC_API_URL=https://api.example.cl
# Orígenes que pueden llamar a la API desde un navegador (la central y la consola). La app móvil no usa CORS.
CORS_ORIGINS=https://central.example.cl,https://plataforma.example.cl

# --- Postgres ---
# Dueño de las tablas (migraciones). Solo lo usan los contenedores db y migrate.
POSTGRES_PASSWORD=
# Rol de la API (guardia_app, sujeto a RLS). migrate le fija esta contraseña.
APP_DB_PASSWORD=
DATABASE_POOL_MAX=10

# --- Sesiones (32+ caracteres) ---
JWT_ACCESS_SECRET=
# Opcionales: refresh del vecino 30 días; del operador 13 h (un turno + margen).
# JWT_REFRESH_TTL_SECONDS=2592000
# JWT_OPERATOR_REFRESH_TTL_SECONDS=46800
# Consola de plataforma: secreto de sus JWT y llave que cifra los secretos TOTP. Distintos entre sí y del
# anterior. Perder PLATFORM_ENCRYPTION_KEY obliga a restablecer el segundo factor de todo el equipo.
PLATFORM_JWT_SECRET=
PLATFORM_ENCRYPTION_KEY=

# --- SMS (OTP del vecino). console está prohibido en producción. ---
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número o remitente habilitado para Chile, en formato E.164.
TWILIO_FROM=

# --- Archivos (MinIO del compose) ---
# Usuario y clave raíz de MinIO; la API los usa para subir y firmar. 20+ caracteres la clave.
S3_ACCESS_KEY=guardia
S3_SECRET_KEY=
S3_BUCKET=guardia-media
SIGNED_URL_TTL_SECONDS=300
# La API exige que no quede el valor por defecto, aunque en producción no se use el disco local.
LOCAL_STORAGE_SECRET=

# --- IA (sin key: clasificación por palabras clave y sin transcripción; el SOS funciona igual) ---
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_CLASSIFY_MODEL=gpt-4o-mini

# --- Push al vecino (Expo). El token solo si la cuenta Expo tiene "push security" activada. ---
# EXPO_ACCESS_TOKEN=

# --- Operación ---
LOG_LEVEL=info
# Si se define, GET /v1/metrics exige "Authorization: Bearer <token>" (16+ caracteres).
METRICS_TOKEN=

# --- Respaldo (backup.sh, cron diario) ---
# Carpeta local de los dump de Postgres (retención 30 días).
BACKUP_DIR=./data/backups
# Copia externa del bucket de media, compatible S3 (Cloudflare R2, Backblaze B2, AWS S3).
# Vacío = solo respaldo local. Recomendado: un destino fuera del VPS.
BACKUP_S3_URL=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=guardia-media-backup
