# ---------------------------------------------------------------------------
# Guard-IA · variables de entorno (copiar a .env). Nunca subir .env al repo.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
PUBLIC_API_URL=http://localhost:3000
# Orígenes permitidos (central). Varios separados por coma.
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# Postgres: la API usa guardia_app (sujeto a RLS); migraciones y seed usan el dueño.
DATABASE_URL=postgres://guardia_app:guardia_app_dev@localhost:5432/guardia
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/guardia

REDIS_URL=redis://localhost:6379

# 32+ caracteres. Generar: openssl rand -base64 48
JWT_ACCESS_SECRET=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres
# Opcionales (valores por defecto): refresh del vecino 30 días; del operador 13 h (un turno + margen).
# JWT_REFRESH_TTL_SECONDS=2592000
# JWT_OPERATOR_REFRESH_TTL_SECONDS=46800

# SMS: console (log) | twilio
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1...
# Solo desarrollo: expone GET /v1/dev/otp/:phone para el simulador
OTP_DEBUG_ENDPOINT=true

# Storage: s3 (MinIO/S3) | local (disco, solo desarrollo)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage
LOCAL_STORAGE_SECRET=dev-only-local-storage-secret
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=guardia-media
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
SIGNED_URL_TTL_SECONDS=300

# IA: openai | mock. Sin OPENAI_API_KEY se usa mock automáticamente.
AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
OPENAI_STT_MODEL=whisper-1
OPENAI_CLASSIFY_MODEL=gpt-4o-mini

# Push Expo (opcional: token de acceso si la cuenta Expo lo exige)
# EXPO_ACCESS_TOKEN=

# Seed
SEED_OPERATOR_PASSWORD=Demo1234!
